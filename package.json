{
  "name": "mod-threat-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run --exclude \"tests/targets/**\"",
    "test:targets": "vitest run tests/targets",
    "headless": "tsx scripts/headless.ts",
    "fork-demo": "tsx scripts/fork-demo.ts",
    "lint": "eslint .",
    "bench": "tsx scripts/bench.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:sim": "tsc -p tsconfig.sim.json --noEmit",
    "screenshot:console": "node scripts/screenshot-console.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
